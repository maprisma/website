# maprisma.com — Apache config (Netcup Webhosting, Plesk Nginx → Apache)
# Keep the /.well-known/ exclusions: Let's Encrypt renewals depend on them.

# ── Basics ────────────────────────────────────────────────────────────────
AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes

# ── Canonical URL: https://maprisma.com (all redirects are 301) ───────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. maprisma.de, www.maprisma.de, www.maprisma.com → https://maprisma.com
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteCond %{HTTP_HOST} ^(www\.maprisma\.(com|de)|maprisma\.de)$ [NC]
  RewriteRule ^ https://maprisma.com%{REQUEST_URI} [R=301,L]

  # 2. http://maprisma.com → https (also detects HTTPS behind the Nginx proxy)
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteCond %{HTTP_HOST} ^maprisma\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://maprisma.com%{REQUEST_URI} [R=301,L]

  # 3. /index.html → / (only when the client asked for it; query string is kept)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://maprisma.com/ [R=301,L]
</IfModule>

# ── Security headers ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # DENY matches CSP frame-ancestors 'none'
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# ── Browser caching ───────────────────────────────────────────────────────
# Images are cached for 30 days: give a changed screenshot a new filename.
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType image/webp              "access plus 30 days"
  ExpiresByType image/svg+xml           "access plus 30 days"
  ExpiresByType image/gif               "access plus 30 days"

  ExpiresByType text/css                "access plus 7 days"
  ExpiresByType application/javascript  "access plus 7 days"

  ExpiresByType application/xml         "access plus 1 hour"
  ExpiresByType text/xml                "access plus 1 hour"
  ExpiresByType text/plain              "access plus 1 hour"

  ExpiresByType text/html               "access plus 5 minutes"
</IfModule>
